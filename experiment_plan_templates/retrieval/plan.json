{
  "plan_id_suffix": "retrieval_eval",
  "task_class": "eval",
  "objective": "Toy retrieval evaluation: run the proposed ranker plus current-best, naive, and random baselines on a deterministic in-memory dataset and emit nDCG@10 evidence under artifacts/metrics.json.",
  "entrypoint": {
    "command": ["python"],
    "args": ["-m", "src.experiment"]
  },
  "resources": {
    "timeout_sec": 300,
    "gpu": null,
    "cpu": 1,
    "memory_gb": 2
  },
  "inputs": {
    "datasets": [],
    "snapshots": []
  },
  "expected_outputs": {
    "metrics_files": ["artifacts/metrics.json"],
    "logs": ["artifacts/run.log"],
    "artifact_dirs": ["artifacts/"]
  },
  "baseline_evidence_requirements": [
    {
      "role": "current_best_known",
      "metric_key": "ndcg_at_10",
      "baseline_key": "current_best_known",
      "operator": "greater_than",
      "margin": 0,
      "required": true
    },
    {
      "role": "naive",
      "metric_key": "ndcg_at_10",
      "baseline_key": "naive",
      "operator": "greater_than",
      "margin": 0,
      "required": true
    },
    {
      "role": "random_or_null",
      "metric_key": "ndcg_at_10",
      "baseline_key": "random_or_null",
      "operator": "greater_than",
      "margin": 0,
      "required": true
    }
  ],
  "guardrails": {
    "allowed_write_roots": ["workspace"],
    "forbidden_actions": [
      "scope_expansion",
      "baseline_changes",
      "shared_memory_write",
      "critic_routing_changes",
      "publication_gate_changes"
    ],
    "scope_policy": "orchestrator_owned_search_policy"
  },
  "failure_index_hints": {
    "domain_tags": ["retrieval"],
    "method_tags": ["retrieval_eval", "toy_dataset"],
    "risk_tags": []
  },
  "reproducibility": {
    "seed": 0,
    "code_snapshot": "experiment_plan_templates/retrieval",
    "data_snapshot": "toy_in_memory"
  }
}
