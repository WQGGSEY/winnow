{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/connector_session.schema.json",
  "title": "ConnectorSession",
  "description": "Artifact of the domain-connector phase: de-domained readings, reduced intake candidates, and the P-aware baseline research required before contract freezing.",
  "type": "object",
  "required": [
    "session_id",
    "type",
    "status",
    "created_at",
    "grilling_session_id",
    "model",
    "field_seed",
    "quota",
    "max_fields_tried",
    "fields_tried",
    "quota_met",
    "stopped_reason",
    "attempts",
    "claims",
    "usage_estimate"
  ],
  "properties": {
    "session_id": { "type": "string", "pattern": "^conn_[A-Za-z0-9_\\-]+$" },
    "type": { "type": "string", "enum": ["connector_session"] },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "completed_no_claims",
        "blocked_by_gate",
        "blocked_by_execution_ack",
        "aborted"
      ]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "grilling_session_id": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "field_seed": { "type": "integer" },
    "quota": { "type": "integer", "minimum": 1 },
    "max_fields_tried": { "type": "integer", "minimum": 1 },
    "fields_tried": { "type": "integer", "minimum": 0 },
    "quota_met": { "type": "boolean" },
    "stopped_reason": {
      "type": "string",
      "enum": ["not_started", "quota_met", "max_fields_tried", "namespace_exhausted"]
    },
    "abstraction": {
      "type": ["object", "null"],
      "required": [
        "abstraction",
        "scanned_domain_terms",
        "residual_leaked_terms",
        "firewall_clean",
        "regen_attempts"
      ],
      "properties": {
        "abstraction": { "type": "string", "minLength": 1 },
        "scanned_domain_terms": { "type": "array", "items": { "type": "string" } },
        "residual_leaked_terms": { "type": "array", "items": { "type": "string" } },
        "firewall_clean": { "type": "boolean" },
        "regen_attempts": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "prune1_passed", "num_pairs", "reduced", "perspective_packet", "error"],
        "properties": {
          "field": {
            "type": "object",
            "required": ["code", "name", "archive"],
            "properties": {
              "code": { "type": "string" },
              "name": { "type": "string" },
              "archive": { "type": "string" }
            },
            "additionalProperties": false
          },
          "prune1_passed": { "type": "boolean" },
          "num_pairs": { "type": "integer", "minimum": 0 },
          "reduced": { "type": "boolean" },
          "perspective_packet": {
            "type": ["object", "null"],
            "required": ["packet_id", "digest", "field", "reading", "correspondence", "far_method"],
            "properties": {
              "packet_id": { "type": "string", "pattern": "^perspective_[a-f0-9]{64}$" },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "field": {
                "type": "object",
                "required": ["code", "name", "archive"],
                "properties": {
                  "code": { "type": "string" },
                  "name": { "type": "string" },
                  "archive": { "type": "string" }
                },
                "additionalProperties": false
              },
              "reading": {
                "type": "object",
                "required": ["reading", "field_mechanism", "predicted_behavior"],
                "properties": {
                  "reading": { "type": "string", "minLength": 1 },
                  "field_mechanism": { "type": "string", "minLength": 1 },
                  "predicted_behavior": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "correspondence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["abstraction_element", "reading_counterpart"],
                  "properties": {
                    "abstraction_element": { "type": "string" },
                    "reading_counterpart": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "far_method": {
                "type": ["object", "null"],
                "required": ["query", "papers", "warnings"],
                "properties": {
                  "query": { "type": "string", "minLength": 1 },
                  "papers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["title", "url", "year", "abstract"],
                      "properties": {
                        "title": { "type": ["string", "null"] },
                        "url": { "type": ["string", "null"] },
                        "year": { "type": ["integer", "string", "null"] },
                        "abstract": { "type": ["string", "null"] }
                      },
                      "additionalProperties": false
                    }
                  },
                  "warnings": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "error": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "claim_contract", "far_ness_note", "method_num_papers", "perspective_packet_id", "perspective_packet_digest"],
        "properties": {
          "field": {
            "type": "object",
            "required": ["code", "name", "archive"],
            "properties": {
              "code": { "type": "string" },
              "name": { "type": "string" },
              "archive": { "type": "string" }
            },
            "additionalProperties": false
          },
          "claim_contract": {
            "type": "object",
            "required": [
              "claim_under_test",
              "mandatory_baselines",
              "success_criteria",
              "disproof_conditions"
            ],
            "properties": {
              "claim_under_test": { "type": "string", "minLength": 1 },
              "mandatory_baselines": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "success_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "disproof_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            },
            "additionalProperties": false
          },
          "far_ness_note": { "type": "string" },
          "method_num_papers": { "type": "integer", "minimum": 1 },
          "perspective_packet_id": { "type": "string", "pattern": "^perspective_[a-f0-9]{64}$" },
          "perspective_packet_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "baseline_research": {
      "type": ["object", "null"],
      "required": ["status", "brief_path", "baseline_dossier_id", "papers_found"],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "completed_with_warnings"] },
        "brief_path": { "type": "string", "minLength": 1 },
        "baseline_dossier_id": { "type": "string", "minLength": 1 },
        "papers_found": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "usage_estimate": {
      "type": "object",
      "required": ["llm_calls"],
      "properties": {
        "llm_calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_output_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": ["number", "null"], "description": "Legacy Claude artifact field." },
        "total_input_tokens": { "type": "integer", "minimum": 0, "description": "Legacy artifact field." },
        "total_output_tokens": { "type": "integer", "minimum": 0, "description": "Legacy artifact field." }
      },
      "additionalProperties": false
    },
    "session_path": { "type": "string" },
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
