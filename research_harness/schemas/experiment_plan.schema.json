{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/experiment_plan.schema.json",
  "title": "ExperimentPlan",
  "type": "object",
  "required": [
    "plan_id",
    "node_id",
    "claim_under_test",
    "objective",
    "task_class",
    "workspace",
    "source_files",
    "entrypoint",
    "resources",
    "inputs",
    "expected_outputs",
    "baseline_evidence_requirements",
    "mandatory_baselines",
    "success_criteria",
    "disproof_conditions",
    "guardrails",
    "failure_index_hints",
    "reproducibility"
  ],
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "claim_under_test": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "task_class": {
      "type": "string",
      "enum": ["smoke_test", "ablation", "training", "eval", "analysis"]
    },
    "workspace": { "type": "string", "minLength": 1 },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entrypoint": {
      "type": "object",
      "required": ["command", "args"],
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["timeout_sec"],
      "properties": {
        "timeout_sec": { "type": "integer", "minimum": 1 },
        "gpu": { "type": ["object", "null"] },
        "cpu": { "type": ["integer", "null"] },
        "memory_gb": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "inputs": { "type": "object" },
    "expected_outputs": { "type": "object" },
    "baseline_evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "metric_key",
          "baseline_key",
          "operator",
          "margin",
          "required"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["current_best_known", "naive", "random_or_null"]
          },
          "metric_key": { "type": "string", "minLength": 1 },
          "baseline_key": { "type": "string", "minLength": 1 },
          "operator": {
            "type": "string",
            "enum": ["greater_than", "greater_equal", "less_than", "less_equal"]
          },
          "margin": { "type": "number", "minimum": 0 },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "mandatory_baselines": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "disproof_conditions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "guardrails": {
      "type": "object",
      "required": ["allowed_write_roots", "forbidden_actions", "scope_policy"],
      "properties": {
        "allowed_write_roots": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbidden_actions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "scope_policy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "failure_index_hints": {
      "type": "object",
      "properties": {
        "domain_tags": { "type": "array", "items": { "type": "string" } },
        "method_tags": { "type": "array", "items": { "type": "string" } },
        "risk_tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "required": ["seed", "code_snapshot", "data_snapshot"],
      "properties": {
        "seed": {},
        "code_snapshot": { "type": "string" },
        "data_snapshot": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
