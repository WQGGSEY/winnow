{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/frontier_item.schema.json",
  "title": "FrontierItem",
  "type": "object",
  "required": [
    "node_id",
    "parent",
    "depth",
    "priority",
    "stage",
    "status",
    "reason"
  ],
  "properties": {
    "node_id": { "type": "string" },
    "parent": { "type": ["string", "null"] },
    "depth": { "type": "integer", "minimum": 0 },
    "priority": { "type": "number" },
    "stage": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "done", "pruned"]
    },
    "reason": { "type": "string" },
    "priority_components": {
      "type": "object",
      "required": [
        "bar_gap_closure",
        "information_gain",
        "mechanism_novelty",
        "capability_fit",
        "normalized_cost",
        "evidence_basis",
        "score"
      ],
      "properties": {
        "bar_gap_closure": { "type": "number", "minimum": 0, "maximum": 1 },
        "information_gain": { "type": "number", "minimum": 0, "maximum": 1 },
        "mechanism_novelty": { "type": "number", "minimum": 0, "maximum": 1 },
        "capability_fit": { "type": "number", "minimum": 0, "maximum": 1 },
        "normalized_cost": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_basis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(observation|direction)_[a-f0-9]{64}$"
          },
          "minItems": 1
        },
        "score": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
