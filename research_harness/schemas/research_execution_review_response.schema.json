{
  "type": "object",
  "required": [
    "decision",
    "reason",
    "evidence",
    "required_work",
    "next_steps",
    "blocking_basis",
    "observation_checks"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_steps": {
      "type": "array",
      "description": "Non-blocking later work, such as qualification before a future execution. These are not prerequisites for the current decision.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_work": {
      "type": "array",
      "description": "Blocking defects that must be resolved BEFORE the current decision can be approved. Empty when decision=approve.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_basis": {
      "type": "array",
      "description": "One grounded basis for each required_work item. Future confirmation requirements belong in next_steps, not blocking development execution.",
      "items": {
        "type": "object",
        "required": [
          "required_work_index",
          "scope",
          "basis_path",
          "basis_quote"
        ],
        "properties": {
          "required_work_index": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "type": "string",
            "enum": [
              "selected_test",
              "runtime_contract",
              "development_protocol",
              "method_semantics",
              "final_confirmation"
            ]
          },
          "basis_path": {
            "type": "string",
            "minLength": 1,
            "description": "Dot path into the supplied packet for the requirement being violated."
          },
          "basis_quote": {
            "type": "string",
            "minLength": 1,
            "description": "Exact nonempty quote from that packet value, not an invented requirement."
          }
        },
        "additionalProperties": false
      }
    },
    "observation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "emitted_by_producer",
          "reason"
        ],
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "emitted_by_producer": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "description": "Exactly one check per observation_contract entry. Trace the named producer to the bound output path. Approval requires every declared count to be emitted, not to be positive."
    }
  },
  "additionalProperties": false
}
