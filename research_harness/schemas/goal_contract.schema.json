{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/goal_contract.schema.json",
  "title": "GoalContract",
  "type": "object",
  "required": [
    "version",
    "contract_id",
    "digest",
    "question",
    "bar",
    "baseline_evidence",
    "safety_limits",
    "holdout_requirement",
    "compiler_version"
  ],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "contract_id": { "type": "string", "pattern": "^contract_[a-f0-9]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "question": { "type": "string", "minLength": 1 },
    "bar": {
      "type": "object",
      "required": [
        "mandatory_baselines",
        "success_criteria",
        "disproof_conditions",
        "operator_requirements",
        "target_scope",
        "acceptable_scopes"
      ],
      "properties": {
        "mandatory_baselines": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "disproof_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "operator_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "target_scope": {
          "type": "string",
          "enum": ["deployment", "feasibility", "directional"]
        },
        "acceptable_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["deployment", "feasibility", "directional"]
          }
        }
      },
      "additionalProperties": false
    },
    "baseline_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_id", "method", "role", "provenance"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["current_best_known", "naive", "random_or_null"]
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "safety_limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "holdout_requirement": {
      "type": "object",
      "required": ["kind", "holdout_source_id", "predicate", "registered_by"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["real_holdout"]
        },
        "holdout_source_id": { "type": "string", "minLength": 1 },
        "predicate": {
          "type": "object",
          "required": ["metric", "op", "threshold"],
          "properties": {
            "metric": { "type": "string", "minLength": 1 },
            "op": { "type": "string", "enum": [">=", ">", "<=", "<", "=="] },
            "threshold": { "type": "number" }
          },
          "additionalProperties": false
        },
        "registered_by": {
          "type": "string",
          "enum": ["operator", "supervisor_bootstrap"]
        }
      },
      "additionalProperties": false
    },
    "compiler_version": { "type": "integer", "enum": [1] }
  },
  "additionalProperties": false
}
