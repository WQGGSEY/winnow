{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/worker_report.schema.json",
  "title": "WorkerReport",
  "type": "object",
  "required": [
    "node_id",
    "status",
    "claim_verdict_candidate",
    "metrics",
    "baselines",
    "disproof_conditions_hit",
    "artifacts",
    "unexpected_observations"
  ],
  "properties": {
    "node_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "blocked_preflight",
        "blocked_permission",
        "timeout_or_turn_exhausted",
        "invalid_worker_output"
      ]
    },
    "claim_verdict_candidate": {
      "type": "string",
      "enum": ["supported", "contradicted", "inconclusive", "not_evaluable"]
    },
    "metrics": { "type": "object" },
    "baselines": { "type": "object" },
    "baseline_evidence_status": { "type": "object" },
    "disproof_conditions_hit": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unexpected_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation", "evidence", "scope_relation"],
        "properties": {
          "observation": { "type": "string" },
          "evidence": { "type": "string" },
          "suggested_branch_type": { "type": ["string", "null"] },
          "scope_relation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "failure_record_candidate": { "type": ["object", "null"] },
    "input_evidence": {
      "type": "object",
      "required": [
        "adapter_id",
        "snapshot_id",
        "content_sha256",
        "manifest_sha256",
        "manifest_path"
      ],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "pattern": "^as_[a-f0-9]{64}$" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manifest_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
