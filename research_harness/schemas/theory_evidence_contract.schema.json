{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "theorem_id", "declaration_name", "statement", "assumptions", "imports", "allowed_axioms", "lean_version"],
  "properties": {
    "version": {"const": 1},
    "theorem_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "declaration_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_']*$"},
    "statement": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_']*$"}, "type": {"type": "string", "minLength": 1}}}},
    "imports": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"}},
    "allowed_axioms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lean_version": {"type": "string", "minLength": 1}
  }
}
