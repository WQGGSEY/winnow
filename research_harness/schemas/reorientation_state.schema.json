        "type": "object",
        "required": ["attempt", "failure_receipt_sha256", "private_lesson_sha256"],
        "properties": {
          "attempt": {
            "type": "object",
            "required": ["attempt_id", "direction_id", "fingerprint", "ordinal"],
            "properties": {
              "attempt_id": { "type": "string", "pattern": "^attempt_[A-Za-z0-9_-]+$" },
              "direction_id": { "type": "string", "pattern": "^direction_[a-f0-9]{64}$" },
              "fingerprint": {
                "type": "object",
                "required": ["fingerprint_id", "mechanism", "intervention", "observables_and_data", "analysis_unit", "timescale", "system_boundary"],
                "properties": {
                  "fingerprint_id": { "type": "string", "pattern": "^fingerprint_[a-f0-9]{64}$" },
                  "mechanism": { "type": "string", "minLength": 1 },
                  "intervention": { "type": "string", "minLength": 1 },
