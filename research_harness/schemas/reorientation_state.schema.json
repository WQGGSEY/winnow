{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/reorientation_state.schema.json",
  "title": "ReorientationState",
  "type": "object",
  "required": ["version", "contract_id", "revision", "closed_attempts", "phase"],
  "properties": {
    "version": { "type": "integer", "enum": [2] },
    "contract_id": { "type": "string", "pattern": "^contract_[a-f0-9]{64}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "closed_attempts": {
      "type": "array",
