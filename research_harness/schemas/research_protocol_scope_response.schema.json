{
  "type": "object",
  "required": [
    "status",
    "answer",
    "evidence",
    "limitations",
    "next_steps",
    "execution_scope"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "unresolved"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_scope": {
      "type": "string",
      "enum": [
        "eligible_for_source_review",
        "blocked",
        "unresolved"
      ],
      "description": "Whether the current proposal has scope to proceed to source review. This is never source approval or execution authorization."
    }
  },
  "additionalProperties": false
}
