{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/baseline_qualification.schema.json",
  "title": "BaselineQualification",
  "type": "object",
  "required": ["dossier_id", "assignments"],
  "properties": {
    "dossier_id": { "type": "string", "minLength": 1 },
    "assignments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "candidate_id", "source_ids", "comparison", "implementation", "reproducibility_receipt"],
        "properties": {
          "role": { "type": "string", "enum": ["current_best_known", "naive", "random_or_null"] },
          "candidate_id": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "comparison": {
            "type": "object",
            "required": ["task_id", "dataset_id", "split_id", "budget_id", "metric_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "dataset_id": { "type": "string", "minLength": 1 },
              "split_id": { "type": "string", "minLength": 1 },
              "budget_id": { "type": "string", "minLength": 1 },
              "metric_id": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "implementation": {
            "type": "object",
            "required": ["kind", "identifier", "version"],
            "properties": {
              "kind": { "type": "string", "enum": ["repository", "package", "local_source"] },
              "identifier": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          },
          "reproducibility_receipt": {
            "type": "object",
            "required": ["node_path", "experiment_plan_path", "worker_report_path", "node_dir", "tree_dir", "metric_id", "baseline_key", "metric_value"],
            "properties": {
              "node_path": { "type": "string", "minLength": 1 },
              "experiment_plan_path": { "type": "string", "minLength": 1 },
              "worker_report_path": { "type": "string", "minLength": 1 },
              "node_dir": { "type": "string", "minLength": 1 },
              "tree_dir": { "type": "string", "minLength": 1 },
              "metric_id": { "type": "string", "minLength": 1 },
              "baseline_key": { "type": "string", "minLength": 1 },
              "metric_value": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
