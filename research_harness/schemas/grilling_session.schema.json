{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/grilling_session.schema.json",
  "title": "GrillingSession",
  "type": "object",
  "required": [
    "session_id",
    "status",
    "user_goal",
    "max_rounds",
    "rounds",
    "extracted",
    "model",
    "created_at",
    "usage_estimate"
  ],
  "properties": {
    "session_id": { "type": "string", "pattern": "^grill_[A-Za-z0-9_\\-]+$" },
    "status": {
      "type": "string",
      "enum": ["in_progress", "done", "max_rounds_reached", "blocked_by_gate", "blocked_by_execution_ack", "aborted"]
    },
    "user_goal": { "type": "string", "minLength": 1 },
    "max_rounds": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Hard cap on the number of agent rounds. Null = unlimited (agent owns DONE)."
    },
    "model": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_index"],
        "properties": {
          "round_index": { "type": "integer", "minimum": 0 },
          "action": { "type": "string", "enum": ["ASK", "PROPOSE_FILE", "DONE"] },
          "question": { "type": "string" },
          "user_response": { "type": "string" },
          "raw_action": { "type": "string" },
          "file": {
            "type": "object",
            "required": ["relative_path", "content"],
            "properties": {
              "relative_path": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string" },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          },
          "file_result": {
            "type": "object",
            "required": ["relative_path", "status"],
            "properties": {
              "relative_path": { "type": "string" },
              "status": { "type": "string", "enum": ["ok", "failed"] },
              "checks": { "type": "object" },
              "staged_at": { "type": ["string", "null"] },
              "manifest_progress": {
                "type": "array",
                "items": { "type": "integer" },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "pending_ask": {
      "type": ["object", "null"],
      "required": ["question"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "raw_action": { "type": "string" },
        "emitted_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scaffold_state": {
      "type": ["object", "null"],
      "required": ["active"],
      "properties": {
        "active": { "type": "boolean" },
        "domain_slug": { "type": ["string", "null"] },
        "staging_dir": { "type": ["string", "null"] },
        "final_destination": { "type": ["string", "null"] },
        "manifest_required": { "type": "array", "items": { "type": "string" } },
        "manifest_staged": { "type": "array", "items": { "type": "string" } },
        "manifest_missing": { "type": "array", "items": { "type": "string" } },
        "proposed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["relative_path", "status"],
            "properties": {
              "relative_path": { "type": "string" },
              "purpose": { "type": "string" },
              "status": { "type": "string", "enum": ["ok", "failed"] },
              "round_index": { "type": "integer" },
              "checks": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "dry_import_result": {
          "type": ["object", "null"],
          "properties": {
            "status": { "type": "string", "enum": ["ok", "failed"] },
            "error": { "type": ["string", "null"] }
          }
        },
        "finalized": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "extracted": {
      "type": "object",
      "required": [
        "root_goal_id",
        "domain",
        "node_type",
        "claim_under_test",
        "mandatory_baselines",
        "success_criteria",
        "disproof_conditions",
        "goal_facets",
        "taste_constraints",
        "search_query_seed"
      ],
      "properties": {
        "root_goal_id": { "type": "string", "pattern": "^rg_[A-Za-z0-9_\\-]+$" },
        "domain": { "type": "string", "minLength": 1 },
        "node_type": {
          "type": "string",
          "enum": [
            "capability",
            "validity",
            "necessity",
            "boundary",
            "mechanism",
            "constraint",
            "taste",
            "operational"
          ]
        },
        "claim_under_test": { "type": "string", "minLength": 1 },
        "mandatory_baselines": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "success_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "disproof_conditions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "goal_facets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "taste_constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "search_query_seed": { "type": "string", "minLength": 1 },
        "alternative_claim_formulations": {
          "type": "array",
          "description": "Multi-root: fundamentally different ways to frame the user_goal as a testable claim. Seeded as parallel root candidates via seed_alternative_root_formulation. The primary claim_under_test should typically appear here as 'strong' so callers see the whole option space in one place.",
          "items": {
            "type": "object",
            "required": ["formulation_id", "claim_under_test", "scope_kind", "scope_note"],
            "properties": {
              "formulation_id": {
                "type": "string",
                "pattern": "^acf_[A-Za-z0-9_]+$",
                "description": "Stable id used by seed_alternative_root_formulation."
              },
              "claim_under_test": { "type": "string", "minLength": 1 },
              "scope_kind": {
                "type": "string",
                "enum": ["strong", "feasibility_narrowed", "alternative_mechanism", "alternative_data_path"],
                "description": "Why this formulation differs from the others. 'strong' = aggressive, full-scope; 'feasibility_narrowed' = scope-restricted to what the envelope actually supports; 'alternative_mechanism' / 'alternative_data_path' = same user_goal, different theory of solution."
              },
              "scope_note": {
                "type": "string",
                "minLength": 1,
                "description": "One sentence on what makes this formulation a different bet than the others — its truth condition should be non-overlapping with siblings."
              },
              "ranked_priority": {
                "type": "integer",
                "minimum": 1,
                "description": "Operator-visible ordering (1 = try first)."
              }
            },
            "additionalProperties": false
          }
        },
        "user_goal_anchors": {
          "type": "array",
          "description": "Rail 3: load-bearing tokens from the user_goal text that the AC will check evidence for at accept-time. Auto-populated by a heuristic extractor at grilling time; operator or LLM can refine and bind each anchor to a worker_report.metrics key.",
          "items": {
            "type": "object",
            "required": ["anchor_text", "must_be_measured"],
            "properties": {
              "anchor_text": {
                "type": "string",
                "minLength": 1,
                "description": "Verbatim or near-verbatim phrase from the user_goal (e.g., '실제 데이터', 'real WorldQuant', 'millions of rows')."
              },
              "anchor_kind": {
                "type": "string",
                "enum": ["data_source", "scale", "metric", "method", "constraint", "other"],
                "description": "What kind of claim load this anchor carries. Drives which worker_report fields are valid bindings."
              },
              "must_be_measured": {
                "type": "boolean",
                "description": "When true, the AC accept-gate requires either a bound_metric_key with a non-null value in worker_report.metrics OR explicit operator-acknowledged scope narrowing in the camera_ready_directives."
              },
              "bound_metric_key": {
                "type": ["string", "null"],
                "description": "Key in worker_report.metrics whose non-null value witnesses this anchor. Null until operator/LLM binds it; unbound anchors trigger confidence down-clamp."
              },
              "extraction_source": {
                "type": "string",
                "enum": ["auto_heuristic", "operator", "llm_grilling"],
                "description": "Provenance of the anchor record."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "usage_estimate": {
      "type": "object",
      "required": ["rounds_used", "total_cost_usd", "total_input_tokens", "total_output_tokens"],
      "properties": {
        "rounds_used": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": ["number", "null"] },
        "total_input_tokens": { "type": "integer", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "session_path": { "type": "string" },
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
