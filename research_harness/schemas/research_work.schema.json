{
  "type": "object",
  "required": [
    "kind",
    "protocol_change",
    "uncertainty",
    "evidence_ids",
    "interpretation",
    "alternatives",
    "test",
    "deferred_questions",
    "next_if_inconclusive",
    "max_runtime_seconds",
    "previous_result",
    "source_mode",
    "required_observations",
    "hypothesis_ids",
    "inquiry_mode",
    "solution_path"
  ],
  "properties": {
    "protocol_change": {
      "type": "string",
      "enum": [
        "not_applicable",
        "study_design",
        "component_binding"
      ],
      "description": "For protocol_revision, distinguish a prospective study design from registration of executable component bytes. component_binding requires source preparation within this work before amendment review; promising future source does not complete it. Use not_applicable for other work kinds."
    },
    "kind": {
      "type": "string",
      "enum": [
        "analysis",
        "protocol_revision",
        "diagnostic_experiment",
        "competence",
        "comparison",
        "replication",
        "confirmation"
      ]
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "explanation",
          "prediction",
          "decision_if_observed",
          "required_observations"
        ],
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "prediction": {
            "type": "string",
            "minLength": 1
          },
          "decision_if_observed": {
            "type": "string",
            "minLength": 1
          },
          "required_observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Subset of this work required_observations needed for this prediction. Include shared validity/support counts. Empty for source analysis only."
          }
        },
        "additionalProperties": false
      }
    },
    "test": {
      "type": "string",
      "description": "One minimal procedure resolving the selected uncertainty. Do not bundle independently useful audits into a composite success condition.",
      "minLength": 1
    },
    "deferred_questions": {
      "type": "array",
      "maxItems": 5,
      "description": "Other relevant questions intentionally outside this work unit; these are not required to accept this diagnostic's result.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_if_inconclusive": {
      "type": "string",
      "minLength": 1
    },
    "max_runtime_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "previous_result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "work_id",
            "result_kind",
            "evidence_ids",
            "prediction_updates",
            "missing_evidence",
            "next_decision"
          ],
          "properties": {
            "work_id": {
              "type": "string",
              "minLength": 1
            },
            "result_kind": {
              "type": "string",
              "enum": [
                "execution_failure",
                "inconclusive",
                "informative",
                "partial"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prediction_updates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "alternative_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "effect": {
                    "type": "string",
                    "enum": [
                      "supported",
                      "weakened",
                      "unresolved"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Declared observation names used by this prediction update; never cite an unavailable count as evidence."
                  }
                },
                "required": [
                  "alternative_index",
                  "effect",
                  "reason",
                  "observation_ids"
                ],
                "additionalProperties": false
              }
            },
            "missing_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "next_decision": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Interpret the completed previous work against each of its predictions. Null only if there is no completed previous work. A development interpretation never qualifies a scientific claim."
    },
    "source_mode": {
      "type": "string",
      "enum": [
        "existing",
        "acquire"
      ],
      "description": "Use acquire for an analysis requiring new primary material. Existing-source analysis cannot establish absence of an unsearched source."
    },
    "required_observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Host-derived union of the alternatives required_observations. For empirical work, names of numeric metrics counting the eligible observations needed to interpret this test. Each must exceed zero. These are sample-support counts, never positive-outcome requirements or treatment-effect thresholds. Use an empty list for analysis/protocol_revision."
    },
    "hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Recorded candidate hypotheses investigated by this work. Empty for shared apparatus or an independent diagnostic."
    },
    "inquiry_mode": {
      "type": "string",
      "enum": [
        "exploration",
        "discrimination",
        "intervention"
      ],
      "description": "Exploration may gather descriptive observations before explanations exist. Discrimination tests explanations. Intervention tests a usable solution."
    },
    "solution_path": {
      "type": "object",
      "required": [
        "parent_work_id",
        "explanation",
        "unexplained_observations",
        "changed_assumption",
        "intervention",
        "expected_goal_effect",
        "next_solution_decision",
        "original_scope_check"
      ],
      "properties": {
        "parent_work_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "unexplained_observations": {
          "type": "string",
          "minLength": 1
        },
        "changed_assumption": {
          "type": "string",
          "minLength": 1
        },
        "intervention": {
          "type": "string",
          "minLength": 1
        },
        "expected_goal_effect": {
          "type": "string",
          "minLength": 1
        },
        "next_solution_decision": {
          "type": "string",
          "minLength": 1
        },
        "original_scope_check": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Provisional explanation and route to solving the immutable goal. State unknown explicitly; intuition is allowed. This is not a validated claim. Link the previous explanation by work ID."
    }
  },
  "additionalProperties": false
}
