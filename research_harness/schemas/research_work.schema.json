{
  "type": "object",
  "required": [
    "kind",
    "protocol_change",
    "uncertainty",
    "evidence_ids",
    "interpretation",
    "alternatives",
    "test",
    "deferred_questions",
    "next_if_inconclusive",
    "max_runtime_seconds"
  ],
  "properties": {
    "protocol_change": {
      "type": "string",
      "enum": ["not_applicable", "study_design", "component_binding"],
      "description": "For protocol_revision, distinguish a prospective study design from registration of executable component bytes. component_binding requires source preparation within this work before amendment review; promising future source does not complete it. Use not_applicable for other work kinds."
    },
    "kind": {
      "type": "string",
      "enum": [
        "analysis",
        "protocol_revision",
        "diagnostic_experiment",
        "competence",
        "comparison",
        "replication",
        "confirmation"
      ]
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "explanation",
          "prediction",
          "decision_if_observed"
        ],
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "prediction": {
            "type": "string",
            "minLength": 1
          },
          "decision_if_observed": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "test": {
      "type": "string",
      "description": "One minimal procedure resolving the selected uncertainty. Do not bundle independently useful audits into a composite success condition.",
      "minLength": 1
    },
    "deferred_questions": {
      "type": "array", "maxItems": 5,
      "description": "Other relevant questions intentionally outside this work unit; these are not required to accept this diagnostic's result.",
      "items": {"type": "string", "minLength": 1}
    },
    "next_if_inconclusive": {
      "type": "string",
      "minLength": 1
    },
    "max_runtime_seconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
