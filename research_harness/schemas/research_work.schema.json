{
  "type": "object",
  "required": [
    "kind",
    "uncertainty",
    "evidence_ids",
    "interpretation",
    "alternatives",
    "test",
    "deferred_questions",
    "next_if_inconclusive",
    "max_runtime_seconds"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "analysis",
        "diagnostic",
        "competence",
        "comparison",
        "replication"
      ]
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "explanation",
          "prediction",
          "decision_if_observed"
        ],
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "prediction": {
            "type": "string",
            "minLength": 1
          },
          "decision_if_observed": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "test": {
      "type": "string",
      "description": "One minimal procedure resolving the selected uncertainty. Do not bundle independently useful audits into a composite success condition.",
      "minLength": 1
    },
    "deferred_questions": {
      "type": "array", "maxItems": 5,
      "description": "Other relevant questions intentionally outside this work unit; these are not required to accept this diagnostic's result.",
      "items": {"type": "string", "minLength": 1}
    },
    "next_if_inconclusive": {
      "type": "string",
      "minLength": 1
    },
    "max_runtime_seconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
