{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_harness/manual_live_smoke_plan.schema.json",
  "title": "ManualLiveSmokePlan",
  "type": "object",
  "required": [
    "status",
    "execution_enabled",
    "reason",
    "preflight_summary",
    "auth_preflight",
    "claude_cli",
    "billing_guard",
    "runtime_guard",
    "live_invocation_envelope_path",
    "live_invocation_envelope",
    "manual_command",
    "manual_stdout_path",
    "ingest_command",
    "expected_output_path",
    "worker_report_path",
    "ingest_metadata_path",
    "runbook_path",
    "post_run_checks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready_to_manually_run",
        "blocked_by_billing_guard",
        "blocked_by_auth",
        "blocked_by_missing_cli",
        "blocked_by_local_preflight"
      ]
    },
    "execution_enabled": { "type": "boolean" },
    "reason": { "type": "string" },
    "preflight_summary": { "type": "object" },
    "auth_preflight": {
      "type": "object",
      "required": ["ok", "mode", "reason", "details"],
      "properties": {
        "ok": { "type": "boolean" },
        "mode": { "type": "string" },
        "reason": { "type": ["string", "null"] },
        "details": {
          "type": ["object", "null"],
          "properties": {
            "logged_in": { "type": "boolean" },
            "auth_method": { "type": ["string", "null"] },
            "api_provider": { "type": ["string", "null"] },
            "subscription_type": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "claude_cli": {
      "type": "object",
      "required": ["found", "path"],
      "properties": {
        "found": { "type": "boolean" },
        "path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "billing_guard": {
      "type": "object",
      "required": [
        "requires_ack",
        "ack_env",
        "ack_value",
        "ack_ok",
        "api_key_present"
      ],
      "properties": {
        "requires_ack": { "type": "boolean" },
        "ack_env": { "type": ["string", "null"] },
        "ack_value": { "type": ["string", "null"] },
        "ack_ok": { "type": "boolean" },
        "api_key_present": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "runtime_guard": {
      "type": "object",
      "required": [
        "execution_mode",
        "auto_execution",
        "requires_subscription_oauth",
        "requires_anthropic_api_key_unset",
        "output_contract"
      ],
      "properties": {
        "execution_mode": { "type": "string", "enum": ["manual_only"] },
        "auto_execution": { "type": "string", "enum": ["forbidden"] },
        "requires_subscription_oauth": { "type": "boolean" },
        "requires_anthropic_api_key_unset": { "type": "boolean" },
        "output_contract": {
          "type": "string",
          "enum": ["worker_task_result_then_harness_worker_report"]
        }
      },
      "additionalProperties": false
    },
    "live_invocation_envelope_path": { "type": "string" },
    "live_invocation_envelope": { "type": "object" },
    "manual_command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "manual_stdout_path": { "type": "string" },
    "ingest_command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expected_output_path": { "type": "string" },
    "worker_report_path": { "type": "string" },
    "ingest_metadata_path": { "type": "string" },
    "runbook_path": { "type": "string" },
    "post_run_checks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
