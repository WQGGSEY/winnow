{
  "runtime": {
    "default_backend": "mock",
    "auth_policy": {
      "provider": "claude_code",
      "mode": "subscription_oauth",
      "require_no_anthropic_api_key": true,
      "token_source": "login_session_or_setup_token",
      "fail_if_api_key_present": true,
      "require_cli_auth_status": true,
      "allowed_subscription_types": ["pro", "max", "team", "enterprise"]
    },
    "worker_turn_budgets": {
      "text_worker": 2,
      "experiment_worker": 6,
      "critic_worker": 3
    },
    "runner_timeouts": {
      "smoke_test": 60,
      "analysis": 300,
      "eval": 900,
      "ablation": 7200,
      "training": 21600
    },
    "agent_models": {
      "default": "sonnet",
      "grilling_agent": "sonnet",
      "market_research_agent": "sonnet",
      "research_refiner_agent": "sonnet",
      "lesson_distillation_agent": "sonnet"
    },
    "worker_backends": {
      "mock": {
        "required_for_ci": true
      },
      "claude_code_dry_run": {
        "executes_agent": false
      },
      "claude_code_live": {
        "manual_smoke_only": true,
        "requires_auth_preflight": true,
        "requires_billing_ack": true,
        "billing_ack_env": "RESEARCH_HARNESS_ALLOW_CLAUDE_LIVE",
        "billing_ack_value": "subscription_ack",
        "model": "sonnet",
        "max_budget_usd": "0.25",
        "tools": ""
      }
    }
  },
  "memory": {
    "failure_retrieval_top_k": 5,
    "baseline_dossier_detail_policy": "on_demand",
    "lessons": {
      "always_include_active": true,
      "max_chars_per_lesson": 240,
      "distill_when_count_exceeds": 40,
      "distillation_token_threshold_bytes": 2000
    }
  },
  "publishing": {
    "default_outputs": ["interactive_html", "slides_html"],
    "allow_tex": false,
    "paper_format": "markdown_first",
    "slides_format": "html",
    "interactive_html": {
      "include_tree_viz": true,
      "include_claim_map": true,
      "include_failure_summary": true,
      "include_rebuttal_and_ac": true
    },
    "token_policy": {
      "avoid_tex_until_final": true,
      "prefer_structured_artifacts": true
    }
  },
  "experiment_plan_templates": {
    "directories": [
      "experiment_plan_templates"
    ],
    "fallback_template_id": "_fallback_demo"
  },
  "publication_gate": {
    "enabled": true,
    "rebuttal": {
      "enabled": true,
      "max_depth": 2,
      "max_new_nodes": 3,
      "allow_baseline_refresh": true,
      "allow_expensive_scaleup": false
    },
    "ac_agent": {
      "enabled": true,
      "decision_options": ["accept", "revise", "reject"],
      "accept_thresholds": {
        "validity": 7,
        "necessity": 6,
        "reproducibility": 6,
        "taste_alignment": 7
      }
    }
  }
}
